# Supabase Postgres connection (Transaction pooler, port 6543, recommended for Vercel)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Public site origin used for metadata, password-reset links, etc.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# First-owner bootstrap (REMOVE after first successful login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-12+chars

# Supabase Storage (S3-compatible) for private uploads
S3_BUCKET=homeland-uploads
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-supabase-s3-access-key
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-key

# Optional: upload size cap in bytes (default 104857600 = 100MB)
# MAX_UPLOAD_BYTES=104857600

# Optional: Resend for password-reset emails
# RESEND_API_KEY=
# EMAIL_FROM="HOMELAND <noreply@your-domain.example>"
